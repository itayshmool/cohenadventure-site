---
// Server-rendered so any post slug (incl. Hebrew) resolves dynamically at
// request time — prerendered Hebrew-slug static paths 404 on the Wix host.
export const prerender = false;
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../lib/i18n';
import { DICT } from '../../lib/i18n';
import { wix, imageUrl } from '../../lib/wix';
import { SITE } from '../../lib/site';
import { renderRicos } from '../../lib/ricos';
import { getPosts } from '../../lib/content';

const lang: Lang = Astro.url.searchParams.get('lang') === 'en' ? 'en' : 'he';
const t = DICT[lang];
const he = lang === 'he';
const { slug } = Astro.params;

let post: any = null;
try {
  const res: any = await wix.posts.getPostBySlug(decodeURIComponent(slug ?? ''), {
    fieldsets: ['RICH_CONTENT'],
  });
  post = res?.post ?? res;
} catch (e) {
  console.error('[journal] getPostBySlug failed:', (e as any)?.message);
}

const cover = post ? imageUrl(post.media?.wixMedia?.image ?? post.coverMedia?.image, 1400, 760) : null;
// Full rich-content render (images, video, GPX files, styled text) — not just paragraphs.
const bodyHtml = post ? renderRicos(post.richContent) : '';
const tags: string[] = post ? (post.hashtags ?? []).filter(Boolean) : [];
const fmtDate = (iso: string) => { try { return new Date(iso).toLocaleDateString(he ? 'he-IL' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }); } catch { return ''; } };
const arrowBack = he ? 'arrow-right' : 'arrow-left';
const arrow = he ? 'arrow-left' : 'arrow-right';

// Related posts (exclude the current one).
let related: any[] = [];
try { related = (await getPosts(7)).filter((p) => p.slug !== post?.slug).slice(0, 3); } catch {}

const ogImage = (post ? imageUrl(post.media?.wixMedia?.image ?? post.coverMedia?.image, 1200, 630) : null) ?? `${SITE}/og-default.jpg`;
const desc = String(post?.excerpt || t.footBlurb || '').slice(0, 200);
const articleJsonLd = post ? {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: post.title, description: desc, image: ogImage,
  datePublished: post.firstPublishedDate, dateModified: post.lastPublishedDate || post.firstPublishedDate,
  inLanguage: lang,
  author: { '@type': 'Person', name: he ? 'צביקה כהן' : 'Zvika Cohen' },
  publisher: { '@type': 'Organization', name: 'Cohen Adventure' },
  mainEntityOfPage: SITE + Astro.url.pathname,
} : undefined;
---

<Base lang={lang} title={post ? `${post.title} · Cohen Adventure` : 'Cohen Adventure'} description={desc} image={ogImage} type="article" jsonLd={articleJsonLd} noindex={!post}>
  <main id="top" style="padding-top:70px;">
    <article style="max-width:820px;margin:0 auto;padding:clamp(28px,6vh,64px) clamp(16px,4vw,40px);">
      <a href={`/journal?lang=${lang}`} style="display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--fg-dim);margin-bottom:26px;">
        <i data-lucide={arrowBack} style="width:14px;height:14px;"></i>{t.journalViewAll}
      </a>
      {post ? (
        <>
          <div class="ofr-mono" style="font-size:11px;letter-spacing:.1em;color:var(--terra);margin-bottom:14px;">
            {t.journalKicker} · {fmtDate(post.firstPublishedDate)}{post.minutesToRead ? ` · ${post.minutesToRead} ${t.minRead}` : ''}
          </div>
          <h1 style="font-family:var(--disp);font-weight:700;font-size:clamp(32px,5.6vw,60px);line-height:1.03;text-transform:uppercase;margin:0 0 24px;">{post.title}</h1>
          {cover && <img src={cover} alt={post.title} width="1400" height="760" fetchpriority="high" decoding="async" style="width:100%;height:auto;border-radius:12px;border:1px solid var(--line);margin-bottom:30px;display:block;" />}
          <div class="article-body" set:html={bodyHtml}></div>
          {tags.length > 0 && (
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:34px;padding-top:22px;border-top:1px solid var(--line);">
              {tags.map((tag) => (
                <span class="ofr-mono" style="font-size:11px;letter-spacing:.04em;color:var(--sand);border:1px solid var(--line-strong);border-radius:999px;padding:5px 12px;">#{tag}</span>
              ))}
            </div>
          )}
        </>
      ) : (
        <p style="color:var(--fg-dim);">{he ? 'הכתבה לא נמצאה.' : 'Post not found.'}</p>
      )}
    </article>

    {related.length > 0 && (
      <section style="border-top:1px solid var(--line);background:var(--ink-2);padding:clamp(40px,6vh,72px) 0;">
        <div style="max-width:var(--maxw);margin:0 auto;padding:0 clamp(16px,4vw,40px);">
          <h2 style="font-family:var(--disp);font-weight:700;font-size:clamp(20px,3vw,30px);text-transform:uppercase;margin:0 0 22px;">{t.journalTitle}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;">
            {related.map((p) => (
              <a href={`/journal/${encodeURIComponent(p.slug)}?lang=${lang}`} style="display:flex;flex-direction:column;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface);color:var(--fg);text-decoration:none;">
                <div style="aspect-ratio:16/10;overflow:hidden;">
                  {p.cover
                    ? <img src={p.cover} alt={p.title} loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block;" />
                    : <div style="width:100%;height:100%;background:linear-gradient(150deg,#5a4326,#c9a56a);"></div>}
                </div>
                <div style="padding:14px 15px 16px;">
                  <div class="ofr-mono" style="font-size:10px;color:var(--fg-faint);margin-bottom:7px;">{fmtDate(p.date)}</div>
                  <h3 style="font-family:var(--disp);font-weight:600;font-size:17px;text-transform:uppercase;margin:0;line-height:1.1;">{p.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <style is:global>
    .article-body{font-size:17px;line-height:1.85;color:var(--fg-dim);}
    .article-body p{margin:0 0 18px;}
    .article-body strong{color:var(--fg);font-weight:700;}
    .article-body a{color:var(--amber-hi);text-decoration:underline;text-underline-offset:2px;}
    .article-body h2,.article-body h3,.article-body h4{font-family:var(--disp);color:var(--fg);text-transform:uppercase;line-height:1.15;margin:34px 0 14px;}
    .article-body h2{font-size:clamp(22px,3.4vw,30px);} .article-body h3{font-size:clamp(19px,2.6vw,24px);} .article-body h4{font-size:18px;}
    .article-body .rc-img,.article-body .rc-video{margin:26px 0;}
    .article-body .rc-img img,.article-body .rc-video video{width:100%;height:auto;display:block;border-radius:12px;border:1px solid var(--line);}
    .article-body .rc-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin:26px 0;}
    .article-body .rc-gallery img{width:100%;height:100%;object-fit:cover;border-radius:10px;border:1px solid var(--line);}
    .article-body .rc-hr{border:0;border-top:1px solid var(--line-strong);margin:32px 0;}
    .article-body .rc-list{margin:0 0 18px;padding-inline-start:1.4em;} .article-body .rc-list li{margin:0 0 8px;}
    .article-body .rc-quote{margin:24px 0;padding:6px 18px;border-inline-start:3px solid var(--amber);color:var(--fg);font-style:italic;}
    .article-body .rc-code{background:var(--ink-3);border:1px solid var(--line);border-radius:8px;padding:14px;overflow:auto;font-family:var(--mono);font-size:14px;}
    .article-body .rc-file{display:inline-flex;align-items:center;gap:12px;margin:20px 0;padding:13px 18px;border:1px solid var(--line-strong);border-radius:10px;background:var(--surface);color:var(--fg);text-decoration:none;transition:border-color .18s ease;}
    .article-body .rc-file:hover{border-color:var(--amber);}
    .article-body .rc-file-ic{width:34px;height:34px;display:grid;place-items:center;border-radius:8px;background:rgba(234,179,8,.14);color:var(--amber);font-size:18px;font-weight:700;}
    .article-body .rc-file-tx{display:flex;flex-direction:column;line-height:1.3;} .article-body .rc-file-tx small{color:var(--fg-faint);font-family:var(--mono);font-size:11px;}
  </style>
</Base>
