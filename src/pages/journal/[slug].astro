---
// Server-rendered so any post slug (incl. Hebrew) resolves dynamically at
// request time — prerendered Hebrew-slug static paths 404 on the Wix host.
export const prerender = false;
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../lib/i18n';
import { DICT } from '../../lib/i18n';
import { wix, imageUrl } from '../../lib/wix';
import { SITE } from '../../lib/site';

const lang: Lang = Astro.url.searchParams.get('lang') === 'en' ? 'en' : 'he';
const t = DICT[lang];
const he = lang === 'he';
const { slug } = Astro.params;

let post: any = null;
try {
  const res: any = await wix.posts.getPostBySlug(decodeURIComponent(slug ?? ''), {
    fieldsets: ['RICH_CONTENT'],
  });
  post = res?.post ?? res;
} catch (e) {
  console.error('[journal] getPostBySlug failed:', (e as any)?.message);
}

// Extract readable paragraphs from Ricos rich content.
function paragraphs(rc: any): string[] {
  const out: string[] = [];
  const nodes = rc?.nodes ?? [];
  for (const n of nodes) {
    if (n.type === 'PARAGRAPH' || n.type === 'HEADING') {
      const text = (n.nodes ?? []).map((c: any) => c?.textData?.text ?? '').join('').trim();
      if (text) out.push(text);
    }
  }
  return out;
}

const cover = post ? imageUrl(post.media?.wixMedia?.image ?? post.coverMedia?.image, 1400, 760) : null;
const body = post ? paragraphs(post.richContent) : [];
const fmtDate = (iso: string) => { try { return new Date(iso).toLocaleDateString(he ? 'he-IL' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }); } catch { return ''; } };
const arrowBack = he ? 'arrow-right' : 'arrow-left';

const ogImage = (post ? imageUrl(post.media?.wixMedia?.image ?? post.coverMedia?.image, 1200, 630) : null) ?? `${SITE}/og-default.jpg`;
const desc = String(post?.excerpt || t.footBlurb || '').slice(0, 200);
const articleJsonLd = post ? {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: post.title, description: desc, image: ogImage,
  datePublished: post.firstPublishedDate, dateModified: post.lastPublishedDate || post.firstPublishedDate,
  inLanguage: lang,
  author: { '@type': 'Person', name: he ? 'צביקה כהן' : 'Zvika Cohen' },
  publisher: { '@type': 'Organization', name: 'Cohen Adventure' },
  mainEntityOfPage: SITE + Astro.url.pathname,
} : undefined;
---

<Base lang={lang} title={post ? `${post.title} · Cohen Adventure` : 'Cohen Adventure'} description={desc} image={ogImage} type="article" jsonLd={articleJsonLd} noindex={!post}>
  <main id="top" style="padding-top:70px;">
    <article style="max-width:820px;margin:0 auto;padding:clamp(28px,6vh,64px) clamp(16px,4vw,40px);">
      <a href={`/?lang=${lang}#journal`} style="display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--fg-dim);margin-bottom:26px;">
        <i data-lucide={arrowBack} style="width:14px;height:14px;"></i>{t.backTrips}
      </a>
      {post ? (
        <>
          <div class="ofr-mono" style="font-size:11px;letter-spacing:.1em;color:var(--terra);margin-bottom:14px;">{t.journalKicker} · {fmtDate(post.firstPublishedDate)}</div>
          <h1 style="font-family:var(--disp);font-weight:700;font-size:clamp(32px,5.6vw,60px);line-height:1;text-transform:uppercase;margin:0 0 24px;">{post.title}</h1>
          {cover && <img src={cover} alt={post.title} width="1400" height="760" fetchpriority="high" decoding="async" style="width:100%;height:auto;border-radius:12px;border:1px solid var(--line);margin-bottom:30px;display:block;" />}
          <div style="font-size:17px;line-height:1.8;color:var(--fg-dim);">
            {body.length
              ? body.map((para) => <p style="margin:0 0 18px;">{para}</p>)
              : <p style="margin:0 0 18px;">{post.excerpt}</p>}
          </div>
        </>
      ) : (
        <p style="color:var(--fg-dim);">Post not found.</p>
      )}
    </article>
  </main>
</Base>
