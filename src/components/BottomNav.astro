---
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const he = lang === 'he';
// Anchor links resolve from any page (journal detail included).
const base = `/?lang=${lang}`;
const tabs = [
  { icon: 'home', he: 'בית', en: 'Home', href: base },
  { icon: 'mountain', he: 'מסעות', en: 'Trips', href: `${base}#roadbook` },
  { icon: 'compass', he: 'הדרכות', en: 'Training', href: `${base}#training` },
  { icon: 'newspaper', he: 'יומן', en: 'Journal', href: `/journal?lang=${lang}` },
  { icon: 'send', he: 'צור קשר', en: 'Contact', href: `${base}#contact` },
];
---
<nav class="bottom-nav" aria-label={he ? 'ניווט' : 'Navigation'}
  style="position:fixed;inset-inline:0;bottom:0;z-index:70;display:none;background:rgba(11,10,9,.9);backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);border-top:1px solid var(--line-strong);padding:8px 4px calc(env(safe-area-inset-bottom,0px) + 8px);">
  {tabs.map((tb) => (
    <a href={tb.href} style="flex:1;min-height:46px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:var(--fg-dim);text-decoration:none;-webkit-tap-highlight-color:transparent;">
      <i data-lucide={tb.icon} style="width:22px;height:22px;"></i>
      <span style="font-family:var(--disp);font-weight:600;font-size:10px;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;">{tb[lang]}</span>
    </a>
  ))}
</nav>
