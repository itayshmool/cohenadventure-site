---
import type { Lang } from '../lib/i18n';
import { DICT, NAV } from '../lib/i18n';
import Logo from './Logo.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = DICT[lang];
const he = lang === 'he';
const otherLang: Lang = he ? 'en' : 'he';
const url = new URL(Astro.url);
const langHref = (l: Lang) => { const u = new URL(url); u.searchParams.set('lang', l); return u.pathname + u.search; };
const btn = 'border:none;padding:8px 13px;font-family:var(--mono);font-size:12px;font-weight:600;cursor:pointer;transition:all .15s ease;text-decoration:none;display:inline-block;';
const on = btn + 'background:var(--amber);color:#1a1508;';
const off = btn + 'background:transparent;color:var(--fg-dim);';
---
<header style="position:fixed;top:0;inset-inline:0;z-index:60;background:rgba(11,10,9,.74);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line);">
  <div style="max-width:var(--maxw);margin:0 auto;padding:0 clamp(16px,4vw,40px);height:64px;display:flex;align-items:center;justify-content:space-between;gap:18px;">
    <a href={`/?lang=${lang}`} style="display:flex;align-items:center;gap:12px;color:var(--fg);">
      <Logo height={40} decorative />
      <span class="hdr-wordmark" style="font-family:var(--brand);font-weight:900;font-style:italic;font-size:18px;letter-spacing:.02em;text-transform:uppercase;line-height:1;white-space:nowrap;">Cohen Adventure</span>
    </a>
    <nav class="nav-desktop" aria-label="Primary" style="display:flex;align-items:center;gap:clamp(14px,2.4vw,30px);">
      {NAV.map((n) => (
        <a href={n.href} style="font-family:var(--disp);font-weight:500;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--fg-dim);">{n[lang]}</a>
      ))}
    </nav>
    <div style="display:flex;align-items:center;gap:12px;">
      <!-- desktop: two-pill toggle -->
      <div class="lang-full" style="display:flex;align-items:center;border:1px solid var(--line-strong);border-radius:6px;overflow:hidden;">
        <a href={langHref('he')} style={he ? on : off}>עב</a>
        <a href={langHref('en')} style={!he ? on : off}>EN</a>
      </div>
      <!-- mobile: compact flag toggle → switches to the other language -->
      <a class="lang-flag" href={langHref(otherLang)} aria-label={he ? 'Switch to English' : 'החלף לעברית'} style="display:none;align-items:center;gap:7px;border:1px solid var(--line-strong);border-radius:8px;padding:7px 11px;color:var(--fg);text-decoration:none;background:var(--surface);">
        <span style="font-size:17px;line-height:1;">{he ? '🇬🇧' : '🇮🇱'}</span>
        <span style="font-family:var(--mono);font-size:12px;font-weight:700;">{he ? 'EN' : 'עב'}</span>
      </a>
      <a class="nav-desktop" href="#contact" style="background:var(--amber);color:#1a1508;border:none;border-radius:7px;padding:10px 18px;font-family:var(--disp);font-weight:600;font-size:13px;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;">{t.enquire}</a>
    </div>
  </div>
</header>
