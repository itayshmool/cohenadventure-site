---
// Bespoke Cohen Adventure logo, recreated as inline SVG.
// full=false → compact mark (corona + mountain + gull) for the header.
// full=true  → stacked logo with COHEN / ADVENTURE + language tagline.
interface Props { full?: boolean; tagline?: string; height?: number; dir?: string; decorative?: boolean; }
const { full = false, tagline = '', height = full ? 148 : 42, dir = 'rtl', decorative = false } = Astro.props;
const rays = `<line x1="124.6" y1="243.1" x2="95.8" y2="251.3"/><line x1="121.8" y1="230.7" x2="86.1" y2="237.0"/><line x1="120.3" y1="218.1" x2="82.6" y2="220.7"/><line x1="120.1" y1="205.5" x2="86.7" y2="204.2"/><line x1="121.2" y1="192.8" x2="88.0" y2="188.0"/><line x1="123.7" y1="180.4" x2="87.1" y2="171.1"/><line x1="127.5" y1="168.3" x2="93.6" y2="155.7"/><line x1="132.5" y1="156.6" x2="105.5" y2="143.2"/><line x1="138.7" y1="145.6" x2="108.1" y2="126.1"/><line x1="146.1" y1="135.3" x2="116.6" y2="111.8"/><line x1="154.5" y1="125.8" x2="130.8" y2="102.4"/><line x1="163.9" y1="117.2" x2="142.5" y2="91.2"/><line x1="174.1" y1="109.7" x2="153.3" y2="78.1"/><line x1="185.0" y1="103.3" x2="168.5" y2="71.2"/><line x1="196.6" y1="98.1" x2="185.7" y2="69.9"/><line x1="208.7" y1="94.2" x2="199.1" y2="59.0"/><line x1="221.1" y1="91.5" x2="215.1" y2="54.3"/><line x1="233.7" y1="90.2" x2="231.9" y2="57.0"/><line x1="246.3" y1="90.2" x2="248.1" y2="56.4"/><line x1="258.9" y1="91.5" x2="264.9" y2="54.1"/><line x1="271.3" y1="94.2" x2="280.8" y2="59.4"/><line x1="283.4" y1="98.1" x2="294.4" y2="69.8"/><line x1="295.0" y1="103.3" x2="311.7" y2="70.9"/><line x1="305.9" y1="109.7" x2="326.6" y2="78.2"/><line x1="316.1" y1="117.2" x2="337.1" y2="91.7"/><line x1="325.5" y1="125.8" x2="349.6" y2="102.0"/><line x1="333.9" y1="135.3" x2="363.5" y2="111.7"/><line x1="341.3" y1="145.6" x2="371.6" y2="126.3"/><line x1="347.5" y1="156.6" x2="374.8" y2="143.1"/><line x1="352.5" y1="168.3" x2="386.8" y2="155.6"/><line x1="356.3" y1="180.4" x2="392.8" y2="171.1"/><line x1="358.8" y1="192.8" x2="391.4" y2="188.1"/><line x1="359.9" y1="205.5" x2="393.9" y2="204.2"/><line x1="359.7" y1="218.1" x2="397.6" y2="220.7"/><line x1="358.2" y1="230.7" x2="393.5" y2="236.9"/><line x1="355.4" y1="243.1" x2="384.8" y2="251.5"/>`;
const ridge = 'M 58 302 Q 100 294 128 266 L 156 278 L 188 182 L 210 214 L 234 194 L 272 150 L 286 165 L 300 151 L 322 184 L 360 256 Q 398 294 432 302';
const gull = 'M 318 182 q 11 -13 22 0 q 11 -13 22 0';
const viewBox = full ? '0 44 480 436' : '18 50 444 266';
const sw = full ? 6.5 : 7;
---
<svg viewBox={viewBox} style={`height:${height}px;width:auto;color:var(--fg);overflow:visible;`} role={decorative ? 'presentation' : 'img'} aria-label={decorative ? undefined : 'Cohen Adventure'} aria-hidden={decorative ? 'true' : undefined}>
  <g fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" set:html={rays}></g>
  <path fill="none" stroke="currentColor" stroke-width={full ? 10.5 : 11} stroke-linecap="round" stroke-linejoin="round" d={ridge}></path>
  <path fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" d={gull}></path>
  {full && (
    <>
      <text x="240" y="366" text-anchor="middle" fill="currentColor" style="font-family:var(--brand);font-style:italic;font-weight:900;font-size:68px;">COHEN</text>
      <text x="240" y="418" text-anchor="middle" fill="currentColor" style="font-family:var(--brand);font-style:italic;font-weight:900;font-size:51px;">ADVENTURE</text>
      <text x="240" y="456" text-anchor="middle" fill="currentColor" direction={dir} style="font-family:var(--sans);font-weight:700;font-size:21px;letter-spacing:.02em;">{tagline}</text>
    </>
  )}
</svg>
