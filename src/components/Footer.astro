---
import type { Lang } from '../lib/i18n';
import { DICT, footCols, SOCIALS } from '../lib/i18n';
import Logo from './Logo.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = DICT[lang];
const he = lang === 'he';
const cols = footCols(lang);
const url = new URL(Astro.url);
const langHref = (l: Lang) => { const u = new URL(url); u.searchParams.set('lang', l); return u.pathname + u.search; };
const btn = 'border:none;padding:8px 13px;font-family:var(--mono);font-size:12px;font-weight:600;transition:all .15s ease;text-decoration:none;';
const on = btn + 'background:var(--amber);color:#1a1508;';
const off = btn + 'background:transparent;color:var(--fg-dim);';

// Brand glyphs (lucide dropped brand icons) — single-path Simple Icons logos.
const SOCIAL_PATHS: Record<string, string> = {
  youtube: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12z',
  instagram: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z',
  facebook: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
};
---
<footer style="background:var(--ink);border-top:1px solid var(--line);padding:clamp(48px,7vh,80px) 0 32px;">
  <div style="max-width:var(--maxw);margin:0 auto;padding:0 clamp(16px,4vw,40px);">
    <div class="footer-grid" style="display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:34px;padding-bottom:40px;border-bottom:1px solid var(--line);">
      <div>
        <a href={`/?lang=${lang}`} style="display:inline-block;color:var(--fg);margin-bottom:18px;">
          <Logo full tagline={t.brandTag} dir={he ? 'rtl' : 'ltr'} height={144} />
        </a>
        <p style="color:var(--fg-dim);font-size:14px;line-height:1.6;max-width:34ch;margin:0 0 18px;">{t.footBlurb}</p>
        <div style="display:flex;gap:10px;">
          {SOCIALS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label} class="social-link" style="width:40px;height:40px;border-radius:8px;border:1px solid var(--line-strong);display:grid;place-items:center;color:var(--fg-dim);transition:color .18s ease,border-color .18s ease;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={SOCIAL_PATHS[s.key]} /></svg>
            </a>
          ))}
        </div>
      </div>
      {cols.map((c) => (
        <div>
          <div class="ofr-mono" style="font-size:11px;letter-spacing:.12em;color:var(--fg-faint);margin-bottom:15px;">{c.head}</div>
          <div style="display:flex;flex-direction:column;gap:10px;">
            {c.items.map((i) => <a href="#" style="color:var(--fg-dim);font-size:14px;">{i}</a>)}
          </div>
        </div>
      ))}
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;padding-top:24px;">
      <div class="ofr-mono" style="font-size:12px;color:var(--fg-faint);">{t.copyright}</div>
      <div style="display:flex;align-items:center;border:1px solid var(--line-strong);border-radius:6px;overflow:hidden;">
        <a href={langHref('he')} style={he ? on : off}>עברית</a>
        <a href={langHref('en')} style={!he ? on : off}>English</a>
      </div>
    </div>
  </div>
</footer>
